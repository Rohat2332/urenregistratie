<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BasisUrenregistratie.Views"
             x:Class="BasisUrenregistratie.Views.FormPage">
    <ContentView.Resources>
        <Style x:Key="UniformEntryStyle" TargetType="Entry">
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="UniformPickerStyle" TargetType="Picker">
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Datum" />
        <DatePicker x:Name="WorkDatePicker" />

        <Label Text="Uren" />
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Entry x:Name="HoursEntry"
                   Placeholder="Uren"
                   Keyboard="Numeric"
                   MaxLength="2"
                   WidthRequest="80"
                   Style="{StaticResource UniformEntryStyle}">
                <Entry.Behaviors>
                    <local:NumericMaxBehavior />
                </Entry.Behaviors>
            </Entry>
            <Picker x:Name="MinutesPicker"
                    WidthRequest="100"
                    VerticalOptions="Center">
                <Picker.Items>
                    <x:String>00</x:String>
                    <x:String>15</x:String>
                    <x:String>30</x:String>
                    <x:String>45</x:String>
                </Picker.Items>
            </Picker>
        </HorizontalStackLayout>

        <Label Text="Opmerkingen (optioneel)" />
        <Entry x:Name="RemarksEntry" Placeholder="Opmerkingen" />

        <Button Text="Opslaan" Clicked="OnSaveClicked" />
    </VerticalStackLayout>
</ContentView>
